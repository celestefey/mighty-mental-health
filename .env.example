STRAPI_API_TOKEN=your-strapi-api-token

# Antigravity Marketing Engine / Formspree Webhook Endpoint
ANTIGRAVITY_MARKETING_WEBHOOK_URL=https://your-antigravity-webhook-or-crm.com/api/intake

# Application Domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
